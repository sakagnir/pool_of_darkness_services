# Copier ce fichier en .env puis remplir les valeurs (jamais de vrai secret dans le repo)
# Le pouls vers le tableau de la classe (adresse fournie par le formateur)
# ⚠️ PAS de slash final : sinon l'URL devient //api/pulse et le tableau redirige (carrés morts).
TABLEAU_URL=https://services-battle.vercel.app
GROUPE=Pool of Darkness
COULEUR=#000000

# Base de données (identifiants de dev local)
DB_USER=karaoke
DB_PASSWORD=karaoke
DB_NAME=karaoke
